{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivChat native sticker pack manifest v2",
  "description": "Explicit /admin/sticker/pack/import-v2 contract. Does not replace or widen v1. Actual ZIP, static fallback and official PAG inspection are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "name", "author", "version", "cover", "stickers"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "pack_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "name": {
      "type": "object", "minProperties": 1, "maxProperties": 32,
      "propertyNames": {"minLength": 1, "maxLength": 32},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}
    },
    "author": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "default_install": {"type": "integer", "enum": [0, 1], "default": 0},
    "cover": {"$ref": "#/$defs/filename"},
    "stickers": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "file", "width", "height"],
        "properties": {
          "key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
          "file": {"$ref": "#/$defs/filename"},
          "emoji": {"type": "string", "maxLength": 64, "default": ""},
          "width": {"type": "integer", "minimum": 1, "maximum": 512},
          "height": {"type": "integer", "minimum": 1, "maximum": 512},
          "pag": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false,
                "required": ["file", "profile"],
                "properties": {
                  "file": {"$ref": "#/$defs/filename"},
                  "profile": {"type": "string", "const": "pag-sticker-v1"}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "filename": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$", "not": {"pattern": "\\.\\."}}
  }
}
